# .env.example - run with mock data (zero keys needed)
# Override these when wiring real APIs

search_provider="http"           # real data provider
email_verifier="mock"           # "mock" | "http"
data_api_base=""                # e.g. https://api.apollo.io/v1
data_api_key=""                 # your API key for data provider
verify_api_base=""              # e.g. https://api.millionverifier.com
verify_api_key=""               # your API key for email verifier
chunk_size=50                   # leads per batch (keeps memory flat)
http_batch_size=5               # API calls per batch
output_dir="./data"             # where CSV files are written
allowed_origins="http://localhost:5173,http://localhost:8000,http://localhost:8080,http://localhost:3000"