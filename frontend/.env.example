# Server-side only. Used by the Vercel function in api/parse-icp.ts.
# Set these in Vercel -> Project -> Settings -> Environment Variables
# (or in frontend/.env.local when running `vercel dev`).
# Never prefix them with VITE_: that would publish the key in the browser bundle.
OLLAMA_BASE=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=

# Optional: where the browser sends API calls. Leave empty to use same-origin /api.
VITE_API_BASE=
